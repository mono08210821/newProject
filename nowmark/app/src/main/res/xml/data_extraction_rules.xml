<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Nothing goes to cloud backup: the app never uploads recordings, titles or memos
     automatically. Device-to-device transfer (local, user-initiated) keeps the library index;
     the purchase cache (shared prefs) is not included and is re-read from Play. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="nowmark.db" />
        <include domain="file" path="peaks/" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
